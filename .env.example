# OpenAI-compatible model (baseURL, apiKey, model). One adapter; vendor is config.

# Local dogfood: OpenCode Zen free models
SKILLCANON_MODEL_BASE_URL=https://opencode.ai/zen/v1
SKILLCANON_MODEL_API_KEY=
SKILLCANON_MODEL_ID=big-pickle

# Deployed demo: Gemini Flash (set these on Vercel instead of the Zen values)
# SKILLCANON_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SKILLCANON_MODEL_API_KEY=
# SKILLCANON_MODEL_ID=gemini-3.8-flash

# Daily cap for the server key. A Visitor API key does not count against it.
SKILLCANON_DAILY_CAP=20
