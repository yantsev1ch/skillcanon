# OpenAI-compatible model (baseURL, apiKey, model). One adapter; vendor is config.

# Local dogfood: OpenCode Zen paid/key models. Zen's free tier is locked to OpenCode itself.
SKILLCANON_MODEL_BASE_URL=https://opencode.ai/zen/v1
SKILLCANON_MODEL_API_KEY=
SKILLCANON_MODEL_ID=big-pickle

# Deployed demo: Gemini Flash Lite (set these on Vercel instead of the Zen values)
# SKILLCANON_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SKILLCANON_MODEL_API_KEY=
# SKILLCANON_MODEL_ID=gemini-3.5-flash-lite

# Self-hosted Ollama on the Mac (ngrok → ai-model proxy → :11434)
# Laptop must stay awake. URL changes if you restart ngrok (free random subdomain).
# SKILLCANON_MODEL_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev/v1
# SKILLCANON_MODEL_API_KEY=same-as-OLLAMA_PROXY_KEY
# SKILLCANON_MODEL_ID=llama3.2:3b

# Daily cap for the server key. A Visitor API key does not count against it.
SKILLCANON_DAILY_CAP=20
